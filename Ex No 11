-- Create Keyspace
CREATE KEYSPACE college_ks
WITH REPLICATION = {
    'class': 'SimpleStrategy',
    'replication_factor': 3
};

-- Use Keyspace
USE college_ks;

-- Create Student Table
CREATE TABLE student (
    rollno INT PRIMARY KEY,
    name TEXT,
    dept TEXT
);

-- Insert Records
